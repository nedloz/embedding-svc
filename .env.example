EMBEDDER_MODEL_NAME=intfloat/multilingual-e5-base
SERVICE_NAME=embedding-svc
# Режим внутренней аутентификации: mtls (по умолчанию) — имя вызывающего берётся из X-Caller-Identity,
# который проставляет прокси-сайдкар (см. infra/mtls); insecure — без проверки, только для отладки.
INTERNAL_AUTH_MODE=mtls
AUTH_INTERNAL_PORT=8000

# =========================
# Лимиты запроса
# =========================
# Сервис — единственный источник эмбеддингов на всю систему, поэтому один большой запрос
# не должен иметь возможности исчерпать его память. Потребители режут данные на батчи
# (EMBED_BATCH_SIZE в ingest-worker), эти лимиты — страховка сверху.
MAX_TEXTS_PER_REQUEST=256
MAX_TEXT_CHARS=20000
MAX_TOTAL_CHARS=1000000

# =========================
# Загрузка модели
# =========================
# Модель грузится в фоне после старта процесса; при сбое загрузка повторяется с паузой,
# которая удваивается от MODEL_LOAD_RETRY_WAIT_SEC до MODEL_LOAD_RETRY_MAX_WAIT_SEC.
MODEL_LOAD_RETRY_WAIT_SEC=5
MODEL_LOAD_RETRY_MAX_WAIT_SEC=300
