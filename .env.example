EMBEDDER_MODEL_NAME=BAAI/bge-m3
SERVICE_NAME=embedding-svc
SERVICE_TOKEN=CHANGE_ME
INTERNAL_AUTH_ENABLED=true
INTERNAL_AUTH_HEADER_NAME=X-Service-Token
INTERNAL_SERVICE_NAME_HEADER=X-Service-Name
TRUSTED_SERVICE_TOKENS={"graph-rag-svc":"CHANGE_ME","ingest-worker":"CHANGE_ME"}
AUTH_INTERNAL_PORT=8000

# =========================
# Лимиты запроса
# =========================
# Сервис — единственный источник эмбеддингов на всю систему, поэтому один большой запрос
# не должен иметь возможности исчерпать его память. Потребители режут данные на батчи
# (EMBED_BATCH_SIZE в ingest-worker), эти лимиты — страховка сверху.
MAX_TEXTS_PER_REQUEST=256
MAX_TEXT_CHARS=20000
MAX_TOTAL_CHARS=1000000
